# Modelo generativo
GOOGLE_API_KEY=
ECOMARKET_MODEL=gemini-2.5-flash-lite

# Observabilidad
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ecomarket-final-dev

# Aplicación
APP_ENV=dev
ECOMARKET_DATA_DIR=dataset
ECOMARKET_MILVUS_URI=dataset/ecomarket_milvus.db
ECOMARKET_COLLECTION=ecomarket_knowledge
ECOMARKET_RETRIEVAL_MODE=hybrid
ECOMARKET_CHECKPOINT_DB=dataset/checkpoints.sqlite
ECOMARKET_RETURNS_FILE=dataset/returns.json
ECOMARKET_LABELS_DIR=generated_labels
ECOMARKET_MAX_EXECUTIONS=10
ECOMARKET_MAX_REPLANS=3
